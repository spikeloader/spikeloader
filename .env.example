# Copy to .env, or let ./bootstrap.sh create it. Never commit your local .env.
# Linux x86_64 with nested KVM; budget additional RAM for the host, PostgreSQL and k3s.
OUTER_CPUS=4
OUTER_MEM=8G
OUTER_DISK=40G
SSH_PORT=2222
OUTER_IMG_URL=https://geo.mirror.pkgbuild.com/images/latest/Arch-Linux-x86_64-cloudimg.qcow2
# auto | native | docker
BACKEND=auto

FC_VERSION=v1.17.0
# Built from kernel.org on first use; cached in .lab/kernel/.
GUEST_KERNEL=7.3
GUEST_KERNEL_CONFIG=microvm-kernel-ci-x86_64-6.18.config
GUEST_ROOTFS=archlinux
GUEST_PACKAGES="base openssh"
ROOTFS_SIZE=2G
VM_VCPUS=1
VM_MEM_MIB=256

PG_IMAGE=postgres:17-alpine
PG_PORT=5432
# Optional read-only cluster view. Empty hides it; no kubeconfig exec plugins.
# ./bootstrap.sh --k3s sets it to ~/.kube/spikeloader-k3s.yaml when it is empty.
K8S_KUBECONFIG=
K3S_IMAGE=rancher/k3s:v1.36.5-k3s1
REGISTRY_IMAGE=registry:2

# 0 = as many jobs as fit in the outer VM.
CI_MAX_JOBS=0
# 0 = keep the outer VM running.
CI_IDLE_SHUTDOWN_MIN=30
CI_KEEP_RUNS=50
# MiB, 1-1024; truncation does not stop a job.
CI_MAX_LOG_MB=50
